{
  "name": "unsada-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP no oficial para el aula virtual (Moodle) de la UNSAdA.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "unsada-mcp": "build/index.js"
  },
  "files": [
    "build",
    "vendor",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "tsc",
    "prepare": "node scripts/vendor-pdfjs.mjs",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "login": "tsx src/index.ts login",
    "prepublishOnly": "npm run build"
  },
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "cheerio": "^1.2.0",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
